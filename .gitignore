# =====================================================================
#  NSC-SWENG .gitignore
#  Rule of thumb: commit source, docs, scripts, bundled jars (lib/*.jar)
#  and shared IDE setup. Never commit build output, downloads, personal
#  IDE state, or anything holding a password.
# =====================================================================

# --- Build output (the run scripts rebuild these every time) ---------
out/
bin/
*.class

# --- Downloaded by setup.bat / run-demo.sh (each machine fetches its own)
nickel-sales/lib/javafx/

# --- Secrets: never commit passwords or connection settings ----------
.env
.env.*
*.cnf
mysql-init.txt
db.properties
*.local.properties

# --- IntelliJ IDEA ----------------------------------------------------
# Shared and committed: the .iml, .idea/misc.xml, .idea/modules.xml,
# .idea/libraries/ and the run configurations in .run/.
# Personal per-machine state is ignored:
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sqldialects.xml
*.iws

# --- Eclipse ----------------------------------------------------------
# Shared and committed: .project and .classpath.
.settings/
.metadata/
.recommenders/

# --- VS Code ----------------------------------------------------------
.vscode/

# --- Java crash and log files ------------------------------------------
hs_err_pid*.log
replay_pid*.log
*.log

# --- Local-only files ---------------------------------------------------
*.patch
# Project PDFs / specs kept next to the repo, not in it
/*.pdf
/docs/*.pdf

# --- OS noise -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
~$*
